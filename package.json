{
  "name": "znuny-helper",
  "version": "1.6.33",
  "private": true,
  "description": "Repo-Infrastruktur fuer die Browser-Erweiterung Znuny Helper (Chrome/Edge und Firefox)",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node tools/run-node-test.js",
    "build": "node tools/run-python.js tools/build-release-zips.py",
    "verify": "node tools/run-python.js tools/verify-release-zips.py",
    "sync-firefox": "node tools/run-python.js tools/sync-firefox.py",
    "sync-firefox:check": "node tools/run-python.js tools/sync-firefox.py --check",
    "browser:smoke": "node tools/browser/smoke.js",
    "browser:clicks": "node tools/browser/clicks.js",
    "browser:clicks:show": "node tools/browser/clicks.js --sichtbar",
    "browser:show": "node tools/browser/smoke.js --sichtbar",
    "browser:record": "node tools/browser/smoke.js --sichtbar --aufzeichnen=tools/browser/output/lauf",
    "browser:login": "node tools/browser/capture.js --login",
    "browser:capture": "node tools/browser/capture.js",
    "browser:testserver": "node tools/browser/testserver.js 8099"
  }
}
