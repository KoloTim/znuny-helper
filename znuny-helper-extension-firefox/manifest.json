{
  "manifest_version": 3,
  "name": "Znuny Helper Firefox",
  "version": "0.1.39",
  "description": "Consolidated Znuny helper features with per-feature toggles.",
  "action": {
    "default_title": "Znuny Helper",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "service_worker": "src/background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "znuny-helper@hsrw.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "host_permissions": [
    "https://otrs.staff.hsrw/otrs/index.pl*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*"
      ],
      "js": [
        "vendor/mammoth.browser.min.js",
        "vendor/xlsx.mini.min.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
