{
  "manifest_version": 3,
  "name": "Znuny Helper",
  "version": "1.8.0",
  "description": "Zusatzfunktionen für Znuny: Anhänge ansehen, im Ticket suchen, Vorlagen, Kategorien, Töne – jede Funktion einzeln schaltbar.",
  "action": {
    "default_title": "Znuny Helper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://otrs.staff.hsrw/otrs/index.pl*",
    "https://otrs.staff.hsrw/otrs/customer.pl*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*.mp3",
        "sounds/*.wav"
      ],
      "matches": [
        "https://otrs.staff.hsrw/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*",
        "https://otrs.staff.hsrw/otrs/customer.pl*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*",
        "https://otrs.staff.hsrw/otrs/customer.pl*"
      ],
      "js": [
        "vendor/mammoth.browser.min.js",
        "vendor/xlsx.mini.min.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "short_name": "Znuny Helper",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
