{
  "manifest_version": 3,
  "name": "Znuny Helper",
  "version": "1.5.1",
  "description": "Consolidated Znuny helper features with per-feature toggles.",
  "action": {
    "default_title": "Znuny Helper",
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://otrs.staff.hsrw/otrs/index.pl*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sounds/*.mp3",
        "sounds/*.wav"
      ],
      "matches": [
        "https://otrs.staff.hsrw/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*"
      ],
      "js": [
        "src/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://otrs.staff.hsrw/otrs/index.pl*"
      ],
      "js": [
        "vendor/mammoth.browser.min.js",
        "vendor/xlsx.mini.min.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
